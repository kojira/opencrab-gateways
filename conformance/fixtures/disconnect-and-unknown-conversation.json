{
  "name": "disconnect-and-unknown-conversation",
  "prelude": "hello",
  "steps": [
    {
      "op": "http_post",
      "path": "/api/web-conversations/not-this-gateways/messages",
      "body": {
        "client_message_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
        "text": "hello",
        "attachments": []
      },
      "status": 404
    },
    {
      "op": "sse_open",
      "id": "ev",
      "path": "/api/web-conversations/web-agent-conv/events"
    },
    { "op": "uds_close" },
    {
      "op": "sse_recv",
      "id": "ev",
      "event": "gate_error",
      "data": { "code": "disconnect" }
    },
    { "op": "uds_unlisten" },
    {
      "op": "http_post",
      "path": "/api/web-conversations/web-agent-conv/messages",
      "body": {
        "client_message_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
        "text": "hello",
        "attachments": []
      },
      "status": 503,
      "body_expect": { "error": { "code": "disconnect" } }
    }
  ]
}
